# ==============================================================================
# LawMind AI — Environment Configuration Template
# Copy this file to .env.local and populate with your own project credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Authentication & Private User Storage with RLS)
# Required for user registration, login, and private review history.
# Not required for API-free demo mode.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# ------------------------------------------------------------------------------
# Gemini API Key
# Required for live AI features. The contract-review demo needs no key.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-google-ai-studio-api-key-here
